# Reference only: settings read process environment; .env is NOT automatically loaded.
# Replace placeholders locally and export variables in your shell.
DJANGO_SECRET_KEY=replace-with-a-locally-generated-random-key
DJANGO_DEBUG=1
DATA_MODE=synthetic
ENABLE_DEMO_LOGIN=1
# Optional: seed_demo_user reads this value without printing it.
KHANE_DEMO_PASSWORD=
DEMO_BALE_URL=
GITHUB_URL=
